{
  "entities": {
    "ShopSetting": {
      "title": "Shop Setting",
      "description": "Store configuration and open/closed status document",
      "type": "object",
      "properties": {
        "isOpen": {
          "type": "boolean",
          "description": "Whether store is open for customer orders"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp of last status update"
        },
        "updatedBy": {
          "type": "string",
          "description": "Admin email who changed the shop status"
        }
      },
      "required": ["isOpen"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order document",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "status": { "type": "string" },
        "total": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["status", "total"]
    },
    "Product": {
      "title": "Product",
      "description": "Store inventory product item with pricing and offer configuration",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "unit": { "type": "string" },
        "image": { "type": "string" },
        "imageUrl": { "type": "string" },
        "description": { "type": "string" },
        "isAvailable": { "type": "boolean" },
        "isOffer": { "type": "boolean" },
        "offerType": { "type": "string", "enum": ["percentage", "fixed"] },
        "offerValue": { "type": "number" },
        "offerPrice": { "type": "number" },
        "offerStartDate": { "type": "string" },
        "offerEndDate": { "type": "string" },
        "offerEnabled": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "category", "price", "isAvailable"]
    }
  },
  "firestore": {
    "/shopSettings/{settingId}": {
      "schema": "ShopSetting",
      "description": "Central store settings including open/closed status for Admin and Customer Apps"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders with admin management and deletion capabilities"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Product catalog items with pricing, inventory availability, and promotional offers"
    }
  }
}
