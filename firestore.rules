rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Central Shop Settings (shopSettings/store)
    // Read: open to everyone (Admin App & Customer App both need to know if shop is OPEN or CLOSED)
    // Write: restricted to authenticated admin users
    match /shopSettings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Orders Collection
    // Read: allowed for admin and customers
    // Create: customers can place orders
    // Update & Delete: restricted to authenticated admin users
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    // Products & Categories
    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Admin Device Tokens & Notification Alerts
    match /admin_device_tokens/{tokenId} {
      allow read, write: if isSignedIn();
    }

    match /adminAlerts/{alertId} {
      allow read, write: if isSignedIn();
    }

    // Fallback deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
